{
  "name": "@kushiro-tt/api",
  "version": "0.1.0",
  "private": true,
  "description": "釧路卓球協会 内部データAPI（Cloudflare Workers + D1、Cloudflare Access で保護）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tt-data --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute tt-data --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute tt-data --local --file=./seed.sql",
    "demo": "npm run db:init && npm run db:seed && wrangler dev --local --port 8787 --var DEV_BYPASS:true --var INGEST_HMAC_SECRET:demo-secret",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240000.0",
    "typescript": "^5.6.0",
    "vitest": "~2.1.0",
    "wrangler": "^3.80.0"
  }
}
